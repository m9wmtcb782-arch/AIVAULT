{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aivault.local/comic-engine/schema/scene.schema.json",
  "title": "Comic Engine Scene",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "display_name", "background"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{1,31}$" },
    "display_name": { "type": "string", "minLength": 1, "maxLength": 60 },
    "background": { "type": "string" },
    "props": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "asset"],
        "properties": {
          "id": { "type": "string" },
          "asset": { "type": "string" },
          "x": { "type": "number" },
          "y": { "type": "number" },
          "z": { "type": "integer", "default": 0 }
        }
      }
    }
  }
}
