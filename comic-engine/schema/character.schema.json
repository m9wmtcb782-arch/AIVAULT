{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aivault.local/comic-engine/schema/character.schema.json",
  "title": "Comic Engine Character",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "display_name", "layers"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{1,31}$" },
    "display_name": { "type": "string", "minLength": 1, "maxLength": 40 },
    "voice_id": { "type": ["string", "null"] },
    "layers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["body", "head"],
      "properties": {
        "body": { "type": "string", "description": "Relative path under project assets" },
        "head": { "type": "string" },
        "eyes": { "type": "string" },
        "mouth": { "type": "string" },
        "hair": { "type": "string" }
      }
    },
    "animations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "blink": { "type": "boolean", "default": true },
        "lip_sync": { "type": "boolean", "default": true },
        "head_bob": { "type": "boolean", "default": true },
        "limb_idle": { "type": "boolean", "default": true }
      }
    }
  }
}
