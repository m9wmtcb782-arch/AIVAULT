{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aivault.local/comic-engine/schema/project.schema.json",
  "title": "AIVAULT Comic Engine Project",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "title", "output", "characters", "scenes", "timeline", "governance"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "project_id": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "locale": { "type": "string", "default": "zh-TW" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "fps", "duration_sec", "container", "video_codec"],
      "properties": {
        "width": { "const": 1080 },
        "height": { "const": 1920 },
        "fps": { "const": 30 },
        "duration_sec": { "const": 60 },
        "container": { "const": "mp4" },
        "video_codec": { "const": "h264" },
        "audio_codec": { "type": "string", "default": "aac" }
      }
    },
    "characters": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "$ref": "character.schema.json" }
    },
    "scenes": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "scene.schema.json" }
    },
    "timeline": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "shot.schema.json" }
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "music_track": { "type": ["string", "null"] },
        "subtitle_track": { "type": ["string", "null"] },
        "voice_tracks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["character_id", "path"],
            "properties": {
              "character_id": { "type": "string" },
              "path": { "type": "string" },
              "start_sec": { "type": "number", "minimum": 0 }
            }
          }
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paid_api_enabled", "human_review_required"],
      "properties": {
        "paid_api_enabled": { "type": "boolean", "const": false },
        "human_review_required": { "type": "boolean", "default": true },
        "notes": { "type": "string" }
      }
    },
    "render_log": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["at", "status"],
        "properties": {
          "at": { "type": "string", "format": "date-time" },
          "status": { "enum": ["queued", "running", "ok", "failed", "blocked"] },
          "worker": { "type": "string" },
          "output_path": { "type": "string" },
          "message": { "type": "string" }
        }
      }
    }
  }
}
