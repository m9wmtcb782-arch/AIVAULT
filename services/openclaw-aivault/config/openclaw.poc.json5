// AIVAULT OpenClaw PoC config（本機）。閘道只綁 loopback；工具執行強制沙盒；模型只走本機學徒管線。
{
  gateway: { mode: "local", bind: "loopback", port: 18789 },
  models: { mode: "replace", providers: { aivault: { baseUrl: "http://127.0.0.1:18899/v1", apiKey: "local-no-secret", api: "openai-completions",
    models: [{ id: "apprentice-v3", name: "AIVAULT apprentice pipeline", contextWindow: 32768, maxTokens: 2048, compat: { supportsTools: true, requiresStringContent: true } }] } } },
  agents: { defaults: { model: { primary: "aivault/apprentice-v3" }, sandbox: { mode: "all", scope: "session", workspaceAccess: "none" } },
    entries: { aivault: {} } },
  tools: { deny: ["exec", "process", "write", "edit", "apply_patch", "browser", "web_fetch", "web_search"] },
  plugins: { load: { paths: ["/workspace/oc-poc/services/openclaw-aivault/plugin"] }, slots: { memory: "aivault" }, allow: ["aivault"], entries: { aivault: { enabled: true, hooks: { allowConversationAccess: true }, config: { stateDir: "/workspace/oc-poc/services/openclaw-aivault/state" } } } },
}
