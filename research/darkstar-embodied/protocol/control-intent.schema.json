{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aivault.darkstar.control_intent.v0.1",
  "title": "DarkStarControlIntent",
  "type": "object",
  "required": ["agent", "intent", "ts"],
  "properties": {
    "agent": { "const": "dark-star" },
    "schema": { "type": "string" },
    "id": { "type": "string" },
    "ts": { "type": "number" },
    "intent": { "type": "string", "minLength": 1 },
    "target": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "priority": { "type": "integer", "minimum": 0, "maximum": 100 },
    "motion": {
      "type": "object",
      "properties": {
        "gaze": { "type": "string" },
        "head": { "type": "string" },
        "left_arm": { "type": "string" },
        "right_arm": { "type": "string" },
        "expression": { "type": "string" },
        "legs": { "type": "string" },
        "blend_ms": { "type": "integer", "minimum": 0 }
      }
    },
    "speech": {
      "type": "object",
      "properties": {
        "text": { "type": "string" },
        "enabled": { "type": "boolean" },
        "interruptible": { "type": "boolean" }
      }
    },
    "source": { "type": "object" }
  },
  "additionalProperties": true
}
