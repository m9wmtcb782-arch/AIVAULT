{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aivault.darkstar.visual_event.v0.1",
  "title": "DarkStarVisualEvent",
  "type": "object",
  "required": ["schema", "id", "ts", "type", "confidence", "source"],
  "properties": {
    "schema": { "const": "aivault.darkstar.visual_event.v0.1" },
    "id": { "type": "string" },
    "ts": { "type": "number", "description": "Unix epoch ms" },
    "stream_ts": { "type": "number", "description": "performance.now() at detect" },
    "type": {
      "type": "string",
      "enum": ["face_present", "smile", "head_turn", "wave", "hand_raised", "lost_face"]
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "source": {
      "type": "string",
      "enum": ["mediapipe_face", "mediapipe_hand", "mock", "rule"]
    },
    "payload": { "type": "object" },
    "note": { "type": "string" }
  },
  "additionalProperties": true
}
