{
  "pipelineName": "dark-star-public-material-learn",
  "tronclassLogin": false,
  "plaintextPasswordStorage": false,
  "paidApi": false,
  "match": {
    "autoAcceptThreshold": 0.82,
    "reviewThreshold": 0.55,
    "weights": {
      "exactNormalizedTitle": 0.55,
      "tokenOverlap": 0.25,
      "keywordHit": 0.15,
      "fingerprintBonus": 0.05
    }
  },
  "allowlistDomains": [
    "mohw.gov.tw",
    "www.mohw.gov.tw",
    "fda.gov.tw",
    "www.fda.gov.tw"
  ],
  "allowlistDomainSuffixes": [
    ".mohw.gov.tw",
    ".fda.gov.tw"
  ],
  "blockedHosts": [
    "tronclass.scu.edu.tw",
    "tcmedia.scu.edu.tw"
  ],
  "ingest": {
    "mode": "stub",
    "hook": "dark-star-ebook-ingest-or-import-public-ebook-json",
    "enqueueClassify": true
  },
  "learnNotify": {
    "enabled": true,
    "hook": "event_stub_only",
    "type": "darkstar.public_material.learn"
  },
  "notes": "擴充 allowlist 前須人工審核；禁止寬鬆 *.edu.tw。付費 API 禁用。"
}
